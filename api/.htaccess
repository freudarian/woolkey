# ============================================================
# WoolKey API directory
#
# This folder is served under two hostnames:
#   api.woolkey.com   — the folder IS the document root, so Apache never
#                       reads the site's root .htaccess for these requests
#   woolkey.com/api/  — the root .htaccess applies as usual
#
# Anything the API relies on from the root file therefore has to be repeated
# here, or it silently stops applying on the subdomain.
#
# NOTE: the PHP handler is one of those things. The root .htaccess carries a
# cPanel-generated AddHandler block; it is deliberately NOT copied here,
# because pinning a PHP version in this file would override the account
# default for woolkey.com/api/ too. After pointing the subdomain at this
# folder, check cPanel → MultiPHP Manager that api.woolkey.com has a PHP
# version set — without one, generate.php is served as plain text.
# ============================================================


# ------------------------------------------------------------
# Routing
# ------------------------------------------------------------
#
# Clean URLs for the subdomain, where /api/ is no longer part of the path.
# Requests arriving as woolkey.com/api/generate are rewritten to
# api/generate.php by the root file before these rules ever see them, so the
# two sets never collide.

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteRule ^generate/?$ generate.php [L,QSA]
    RewriteRule ^health/?$   generate.php?health=1 [L]
</IfModule>


# ------------------------------------------------------------
# Error documents — JSON, never HTML
# ------------------------------------------------------------
#
# A client that gets an HTML error page where it expects JSON has to guess at
# what went wrong. Blocked paths (config.php, a directory, a mistyped
# endpoint) answer in the same shape as every other API error.
#
# The URL is host-dependent because the same directory sits at two different
# depths depending on which hostname asked for it.

<If "%{HTTP_HOST} =~ /^api\./">
    ErrorDocument 403 /403.json
    ErrorDocument 404 /404.json
</If>
<Else>
    ErrorDocument 403 /api/403.json
    ErrorDocument 404 /api/404.json
</Else>


# ------------------------------------------------------------
# Security headers the root file would otherwise supply
# ------------------------------------------------------------

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
</IfModule>

# Same reason: the root file's block on dotfiles and stray artefacts does not
# reach the subdomain. "^\." covers every dotfile rather than a named few, so a
# stray .ssh or .netrc is denied without needing to be anticipated; the
# extension list catches key material, which carries no leading dot.
<FilesMatch "(^\.|\.ini$|\.log$|\.(bak|backup|old|orig|save|swp|sql|dist|pem|key|ppk|crt|p12|pfx)$)">
    Require all denied
</FilesMatch>


# Apache strips the Authorization header before PHP sees it unless told not to.
# Without this, "Authorization: Bearer <token>" fails while X-Api-Key works.
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>
CGIPassAuth On

# The root .htaccess sets ExpiresDefault "access plus 1 day". Left alone, that
# adds Cache-Control: max-age=86400 and an Expires header to generated
# credentials, so an intermediary could cache a password for a day. Nothing
# under /api is ever cacheable by that rule.
<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>

# Deny every PHP file in this directory by default...
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>

# ...then re-allow only the endpoint itself.
<Files "generate.php">
    Require all granted
    <IfModule mod_headers.c>
        # "always set" replaces anything inherited, including the root policy.
        Header always set Cache-Control "no-store, no-cache, must-revalidate, private"
        Header always set Referrer-Policy "no-referrer"
        Header always unset Expires
    </IfModule>
</Files>

# Belt and braces: config.php holds the API token and must never be served,
# even if the rules above are edited later.
<Files "config.php">
    Require all denied
</Files>
<Files "config.example.php">
    Require all denied
</Files>

# The OpenAPI document is public on purpose — it describes the contract and
# contains no secrets. CORS is set here so browser-based agents can fetch it.
<Files "openapi.json">
    Require all granted
    <IfModule mod_headers.c>
        Header always set Access-Control-Allow-Origin "*"
        Header always set Cache-Control "public, max-age=300"
    </IfModule>
</Files>

# Postman collection and environment. Public by design and free of secrets —
# the apiKey variable ships empty for the user to fill in. Postman fetches
# these directly when importing by link, so CORS is set for the browser case.
<FilesMatch "\.postman_(collection|environment)\.json$">
    Require all granted
    <IfModule mod_headers.c>
        Header always set Access-Control-Allow-Origin "*"
        Header always set Cache-Control "public, max-age=300"
    </IfModule>
</FilesMatch>

# No directory listing
Options -Indexes
