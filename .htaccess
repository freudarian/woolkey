# ============================================================
# WoolKey — Apache .htaccess
# cPanel / Apache / PHP 8.3
# ============================================================


# ------------------------------------------------------------
# HTTPS redirect
# ------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect all HTTP traffic to HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # API endpoints
    RewriteRule ^api/generate/?$ api/generate.php [L,QSA]
    RewriteRule ^api/health/?$   api/generate.php?health=1 [L]
</IfModule>


# ------------------------------------------------------------
# Custom error pages
# ------------------------------------------------------------
#
# 403 is reachable from the blocks further down this file — config.php,
# dotfiles, directory listings. /api/ overrides both of these with JSON
# equivalents in api/.htaccess, so a client never gets HTML back.

ErrorDocument 403 /403.html
ErrorDocument 404 /404.html


# ------------------------------------------------------------
# MIME types
# ------------------------------------------------------------

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType font/woff2 .woff2
</IfModule>


# ------------------------------------------------------------
# Security headers
# ------------------------------------------------------------

<IfModule mod_headers.c>

    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Prevent this site from being embedded in frames
    Header always set X-Frame-Options "DENY"

    # Referrer privacy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Disable unnecessary browser features
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Remove PHP fingerprint where possible
    Header always unset X-Powered-By

    # Content Security Policy
    #
    # This assumes JavaScript, CSS, fonts, etc. are hosted locally.
    # connect-src 'none' prevents JavaScript from making network/API requests.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"

    # Enable this ONLY after HTTPS is confirmed working correctly.
    # Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

</IfModule>


# ------------------------------------------------------------
# Cache control
# ------------------------------------------------------------

<IfModule mod_expires.c>

    ExpiresActive On

    # Default
    ExpiresDefault "access plus 1 day"

    # HTML - short cache
    ExpiresByType text/html "access plus 5 minutes"

    # CSS / JavaScript — see the revalidation block below. Asset URLs carry no
    # version token, so a long expiry means a returning visitor keeps running
    # last week's stylesheet and scripts after a deploy.
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType text/javascript "access plus 0 seconds"

    # Images
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"

    # Fonts
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType font/woff "access plus 30 days"

    # Web manifest
    ExpiresByType application/manifest+json "access plus 1 day"

</IfModule>


# ------------------------------------------------------------
# CSS / JavaScript freshness
# ------------------------------------------------------------

# These filenames never change and carry no ?v= token, so a long max-age means
# a deploy does not reach anyone who has visited before until it expires.
#
# "no-cache" does not mean "do not store" — the browser still keeps the file
# and still revalidates with If-None-Match, so an unchanged asset costs one
# empty 304 rather than a full download. Correctness over a few bytes.

<FilesMatch "\.(css|js)$">
    <IfModule mod_headers.c>
        Header always set Cache-Control "no-cache, must-revalidate"
        Header always unset Expires
    </IfModule>
</FilesMatch>


# ------------------------------------------------------------
# Service worker must never be served stale
# ------------------------------------------------------------

# ExpiresByType would give this a 7-day max-age like any other .js file, but
# the service worker is the mechanism that ships every other update — a stale
# copy pins visitors to an old build.

<Files "service-worker.js">
    <IfModule mod_expires.c>
        ExpiresActive Off
    </IfModule>
    <IfModule mod_headers.c>
        Header always set Cache-Control "no-cache, must-revalidate"
        Header always unset Expires

        # A service worker runs under the CSP delivered with its own script,
        # not the one on the page that registered it. The site-wide policy
        # sets connect-src 'none' — correct for page JavaScript, fatal here:
        # every fetch the worker makes is checked against it, including the
        # ones cache.addAll() issues during install. Install therefore
        # rejected, the worker went redundant, and the empty cache created
        # moments earlier by caches.open() was orphaned — one per deploy,
        # with activate never running to clear it. Offline support never
        # worked in production at all.
        #
        # 'self' is the whole allowance. The worker can fetch this origin's
        # own assets and nothing else, so nothing can be sent anywhere. The
        # page keeps connect-src 'none', which is what actually guarantees a
        # generated credential cannot leave the browser.
        Header always set Content-Security-Policy "default-src 'self'; connect-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    </IfModule>
</Files>


# ------------------------------------------------------------
# Prevent directory listing
# ------------------------------------------------------------

Options -Indexes


# ------------------------------------------------------------
# Block sensitive / hidden files
# ------------------------------------------------------------

# Protect common configuration / repository files.
#
# IMPORTANT:
# The original Copilot regex used (^.|...)
# That "." matches ANY character and could accidentally block everything.

<FilesMatch "(^\.ht|^\.env|^\.git|\.ini$|\.log$|composer\.(json|lock)$|package(-lock)?\.json$|config\.php$|config\.example\.php$)">
    Require all denied
</FilesMatch>


# ------------------------------------------------------------
# Prevent access to common backup/source files
# ------------------------------------------------------------

<FilesMatch "\.(bak|backup|old|orig|save|swp|sql|dist)$">
    Require all denied
</FilesMatch>


# ------------------------------------------------------------
# PHP 8.3 — cPanel generated handler
# DO NOT EDIT this section through .htaccess if cPanel manages it
# ------------------------------------------------------------

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
    AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit